{
  "name": "@dqa-ai-solutions/ontology-sdk",
  "version": "5.14.2",
  "description": "Backend-agnostic TypeScript ontology SDK — entity / relationship / rule / traversal / provenance over a StorageAdapter. Speaks ontology, never SQL.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DQASolutions/core-runtime.git",
    "directory": "core/ontology-sdk"
  },
  "homepage": "https://github.com/DQASolutions/core-runtime#readme",
  "bugs": {
    "url": "https://github.com/DQASolutions/core-runtime/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js",
      "require": "./dist/input.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" && tsc --noEmit",
    "test": "vitest run",
    "test:memory": "TEST_ADAPTER=memory vitest run",
    "test:postgres": "TEST_ADAPTER=postgres vitest run",
    "test:neo4j": "TEST_ADAPTER=neo4j vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@dqa-ai-solutions/ontology-base": "^0.1.0"
  },
  "peerDependencies": {
    "pg": "^8.13.1",
    "@qdrant/js-client-rest": "^1.12.0",
    "neo4j-driver": "^5.28.3"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "@qdrant/js-client-rest": {
      "optional": true
    },
    "neo4j-driver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qdrant/js-client-rest": "^1.12.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-boundaries": "^4.2.2",
    "neo4j-driver": "^5.28.3",
    "pg": "^8.13.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true
}
