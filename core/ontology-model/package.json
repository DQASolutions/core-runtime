{
  "name": "@dqa-ai-solutions/ontology-model",
  "version": "0.2.0",
  "description": "The shared, pure part of the ontology: concepts, value checks, the rule and condition interpreter, the schema surface, and the ports a backend implements. No Node builtin, no driver, no I/O.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DQASolutions/core-runtime.git",
    "directory": "core/ontology-model"
  },
  "homepage": "https://github.com/DQASolutions/core-runtime#readme",
  "bugs": {
    "url": "https://github.com/DQASolutions/core-runtime/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./input": {
      "types": "./dist/input/index.d.ts",
      "import": "./dist/input/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "import": "./dist/kernel.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dqa-ai-solutions/ontology-base": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^4.0.18",
    "@types/node": "^22.10.0"
  },
  "private": true
}
