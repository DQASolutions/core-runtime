{
  "name": "@dqa-ai-solutions/core-runtime",
  "version": "0.2.0",
  "description": "The shared core, pure and the same on every side: ontology concepts and declarations, value checks, the rule language and its interpreter, the schema surface, the view contract. No Node builtin, no driver, no I/O. The backend engine is @dqa-ai-solutions/ontology-runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DQASolutions/core-runtime.git",
    "directory": "core/core-runtime"
  },
  "homepage": "https://github.com/DQASolutions/core-runtime#readme",
  "bugs": {
    "url": "https://github.com/DQASolutions/core-runtime/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js"
    },
    "./ontology-base": {
      "types": "./dist/ontology-base.d.ts",
      "import": "./dist/ontology-base.js"
    },
    "./kernel": {
      "types": "./dist/kernel.d.ts",
      "import": "./dist/kernel.js"
    },
    "./ontology-base/schema/ontology-file.schema.json": "./dist/ontology-base/schema/ontology-file.schema.json",
    "./ontology-base/schema/ontology-file.schema.yaml": "./dist/ontology-base/schema/ontology-file.schema.yaml",
    "./ontology-base/conformance/cases.yaml": "./dist/ontology-base/conformance/cases.yaml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p . && node ../../scripts/copy-assets.mjs core-runtime",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit && tsc -p tsconfig.check.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dqa-ai-solutions/ontology-base": "^0.1.0",
    "@dqa-ai-solutions/ontology-model": "^0.2.0",
    "@dqa-ai-solutions/ontology-rules": "^0.1.0",
    "@dqa-ai-solutions/view-contract": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
